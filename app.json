{
  "expo": {
    "name": "반려장생",
    "slug": "banryeo-jangsaeng",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "petapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kr.co.outspring.banryeojangsaeng",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#B85C2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFEFD6"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "건강사진과 반려동물 사진을 등록하려면 사진 접근이 필요해요.",
          "cameraPermission": "지금 찍은 사진을 기록에 남기려면 카메라 접근이 필요해요."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2ea4c3c-ab0e-4c11-9c92-8b2280bacac1"
      }
    },
    "owner": "kyoungeun"
  }
}
