# Supabase 대시보드 → Settings → API 에서 받아 이 파일을 `.env`로 복사해 채운다.
# `.env`는 .gitignore에 있다 (AGENTS.md "저장소에 없는 것").
#
# EXPO_PUBLIC_* 은 번들에 그대로 들어간다 — 비밀값을 넣지 않는다. anon key는
# 공개용이고, 실제 방어선은 RLS다 (08_TechStack).
#
# 값을 바꾼 뒤에는 expo를 다시 시작해야 반영된다.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
