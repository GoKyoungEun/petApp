{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "autoPort": true
    },
    {
      "name": "expo-go",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "autoPort": true
    },
    {
      "// web-export": "dist/의 정적 번들을 띄운다. .env 없이 화면만 확인할 때 쓴다 — 먼저 npx expo export --platform web",
      "name": "web-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "serve"],
      "autoPort": true
    }
  ]
}
